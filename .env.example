# Grafana MCP App - Environment Configuration
# Copy this file to .env and fill in your values

# Required: Your Grafana instance URL (no trailing slash)
GRAFANA_BASE_URL=https://grafana.example.com

# Required: Service Account Token from Grafana
# Generate at: Administration → Service Accounts → [account] → Add token
# Token should start with "glsa_"
GRAFANA_SERVICE_TOKEN=glsa_xxxxxxxxxxxx

# Optional: Organization ID (defaults to 1)
# Only needed if using multi-org Grafana
GRAFANA_ORG_ID=1

# Optional: Default theme for embedded panels
# Options: "dark" or "light" (defaults to "dark")
GRAFANA_DEFAULT_THEME=dark

# Optional: HTTP server port for remote deployment
# Only used when running in HTTP mode (without --stdio)
PORT=3001

# Optional: Timeout for iframe load before showing fallback
# In milliseconds (defaults to 10000 = 10 seconds)
GRAFANA_EMBED_TIMEOUT_MS=10000

# Optional: Log level
# Options: "debug", "info", "warn", "error" (defaults to "info")
LOG_LEVEL=info

# Development only: Skip SSL certificate validation
# NEVER set this in production
# NODE_TLS_REJECT_UNAUTHORIZED=0
